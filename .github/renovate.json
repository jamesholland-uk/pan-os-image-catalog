{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>jamesholland-uk/renovate-config"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Patch, minor and pin bumps: automerge once the dry-run checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin"
      ],
      "automerge": true
    },
    {
      "description": "boto3 releases most weekdays: batch into one PR a week",
      "matchPackageNames": [
        "boto3"
      ],
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
